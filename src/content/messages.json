    {
      "id": "overwhelm-01",
      "text": "Let's pick one thing. Just one. The rest will wait.",
      "character": "owl",
      "pose": "neutral",
      "tone": "calm",
      "contexts": ["overwhelm"]
    },
    {
      "id": "overwhelm-02",
      "text": "It's okay to feel like this. Take a slow breath with me.",
      "character": "fox",
      "pose": "neutral",
      "tone": "calm",
      "contexts": ["overwhelm"]
    },
    {
      "id": "overwhelm-03",
      "text": "You don't have to do it all today. One small step is enough.",
      "character": "owl",
      "pose": "neutral",
      "tone": "calm",
      "contexts": ["overwhelm"]
    },
    {
      "id": "overwhelm-04",
      "text": "The list can wait. You are allowed to rest first.",
      "character": "fox",
      "pose": "happy",
      "tone": "calm",
      "contexts": ["overwhelm"]
    },
    {
      "id": "overwhelm-05",
      "text": "Put everything down for a moment. Breathe in. Breathe out.",
      "character": "owl",
      "pose": "sleepy",
      "tone": "calm",
      "contexts": ["overwhelm"]
    },
    {
      "id": "overwhelm-06",
      "text": "Nothing needs to happen all at once. One thing at a time.",
      "character": "fox",
      "pose": "neutral",
      "tone": "calm",
      "contexts": ["overwhelm"]
    },
    {
      "id": "overwhelm-07",
      "text": "Choose the smallest next step. Only that one.",

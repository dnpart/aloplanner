    {
      "id": "came-back-01",
      "text": "Hey, welcome back. Good to see you.",
      "character": "fox",
      "pose": "waving",
      "tone": "calm",
      "contexts": ["came-back"]
    },
    {
      "id": "came-back-02",
      "text": "You're back. The snow kept your spot cozy. Well, cold. Cozy-cold.",

      "pose": "sleepy",
      "tone": "calm",
      "contexts": ["overwhelm"]
    },
    {
      "id": "overwhelm-09",
      "text": "You are doing enough. Let's look at just one task.",
      "character": "owl",
      "pose": "happy",
      "tone": "calm",
      "contexts": ["overwhelm"]
    },
    {
      "id": "overwhelm-10",
      "text": "Feeling a lot is okay. Have some water, then pick one thing.",
